# ====================== 应用配置 ======================
APP_NAME=MODEX AI Backend
DEBUG=false
# JSON 数组格式，生产环境请配置为具体的前端域名
CORS_ORIGINS=["*"]
REQUEST_TIMEOUT=60

# ====================== 模型路由表配置 ======================
ROUTES_CONFIG_PATH=config/routes.json

# ====================== 国内厂商独立 API Key ======================
# DeepSeek 开放平台
DEEPSEEK_API_KEY=
# Moonshot（Kimi）开放平台
MOONSHOT_API_KEY=
# 阿里云百炼 DashScope（Qwen 通义千问）
QWEN_API_KEY=
# 智谱 AI（GLM 系列）
ZHIPU_API_KEY=

# ====================== 国外厂商第三方 Router 配置 ======================
# OpenRouter 统一 API Key（国外模型统一走该 Router 调用）
ROUTER_API_KEY=
ROUTER_BASE_URL=https://openrouter.ai/api/v1
# 可选：OpenRouter 归因标识
ROUTER_SITE_URL=
ROUTER_SITE_NAME=

# ====================== 本地私有化模型服务 ======================
# 本地 OpenAI 兼容服务地址（默认 Ollama，也可指向 vLLM 等）
LOCAL_BASE_URL=http://localhost:11434/v1
